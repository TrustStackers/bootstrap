# Bootstrap / relay server configuration — TEMPLATE (committed).
#
# Do NOT edit this file in place. Copy it to `.env` (gitignored), or better,
# generate `.env` with the init tool:
#
#   npm run init:bootstrap -- --host <dns-or-ip> [--generate | --words-file <path>]
#
# The peer ID is DERIVED from BOOTSTRAP_SEED_HEX; the tool fills in both.
# Never commit a real `.env` — it holds the server's private seed.

# 32-byte Ed25519 seed (64 hex chars). Derives the peer ID.
#
# THIS FILE IS THE ONLY PLACE THE SEED BELONGS. The bootstrap server is the one
# component whose peer ID comes from a word sequence; the agent app and the
# utility server are clients that receive only the derived peer ID (their own
# .env has BOOTSTRAP_PEER_ID + BOOTSTRAP_HOST, never this key).
BOOTSTRAP_SEED_HEX=
# libp2p peer ID (12D3Koo...). Optional — derived from the seed when omitted.
BOOTSTRAP_PEER_ID=
# Public DNS hostname OR fixed public IP that every component dials.
BOOTSTRAP_HOST=
BOOTSTRAP_TCP_PORT=4001
BOOTSTRAP_WS_PORT=4002
BOOTSTRAP_ENABLE_RELAY=true

# ── Logging (optional) ──
# Read at startup by `config/logging-env.ts`, so verbosity lives HERE rather than
# in a package.json script — `P2PTS_LOG_LEVEL=info node …` is POSIX-only syntax
# that PowerShell and cmd cannot parse. Delete a line to fall back to the next
# rung (the process environment, then the default `warn`).
#
# silent | error | warn | info | debug      (default: warn)
P2PTS_LOG_LEVEL=
# 1 turns on the [CEREMONY] OOBI→RFI→RFA trace lines. Independent of the level
# above, so tracing still works with P2PTS_LOG_LEVEL=warn.
CEREMONY_TRACE=

